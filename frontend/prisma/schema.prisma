// Prisma owns the AUTH tables only - and owns them in their own Postgres schema.
//
// Ownership split:
//
//   * Prisma (this file)  -> User / Account / Session / VerificationToken,
//     in the `auth` schema. NextAuth's Prisma adapter requires this exact shape.
//   * SQLAlchemy (backend/app/db.py) -> the domain tables (contracts, clauses,
//     versions, negotiations, review queue, audit log, playbook rules), all
//     prefixed `dharma_`, in the `public` schema.
//
// WHY A SEPARATE SCHEMA, and not just a naming convention:
//
//   `prisma db push` does not merely create the models it knows about - it
//   reconciles the WHOLE schema it is pointed at against this file. Any table it
//   does not recognise is treated as drift to be dropped:
//
//       "You are about to drop the `dharma_playbook_rules` table,
//        which is not empty (14 rows)."
//
//   Sharing `public` therefore made `db push`, run after the backend had created
//   its tables, a data-destroying operation - and the frontend container ran it on
//   every boot. Scoping the datasource to `auth` confines Prisma to its own
//   schema, so the two owners are separated physically rather than by convention.
//
// The frontend's DATABASE_URL must carry `?schema=auth`. The backend strips the
// query string (see config.sqlalchemy_url), so the same base URL is safe for both.
// Domain data reaches the frontend through the FastAPI API, never through Prisma.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  REVIEWER
  BUSINESS_USER
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  // Only set for the credentials provider (the seeded demo logins). bcrypt hash.
  passwordHash  String?
  role          UserRole  @default(BUSINESS_USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]

  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
