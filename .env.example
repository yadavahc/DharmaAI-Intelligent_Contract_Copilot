# ─────────────────────────────────────────────────────────────
# Dharma AI — environment configuration
# Copy to `.env` and fill in. NEVER commit the real `.env`.
# ─────────────────────────────────────────────────────────────

# ---- OpenAI ----
OPENAI_API_KEY=sk-replace-me
OPENAI_MODEL=gpt-4o
OPENAI_EMBED_MODEL=text-embedding-3-small

# ---- Demo mode ----
# When true, agents return deterministic canned output instead of calling
# OpenAI. Lets the full pipeline (and the Playwright e2e test) run with no
# API key, no spend, and no flakiness. Set to false for a live demo.
DHARMA_DEMO_MODE=false

# ---- Postgres ----
POSTGRES_USER=dharma
POSTGRES_PASSWORD=dharma
POSTGRES_DB=dharma
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Backend (SQLAlchemy) owns the `public` schema; it strips the query string.
# The FRONTEND must use ?schema=auth so Prisma manages only its own tables --
# otherwise `prisma db push` treats the backend's dharma_* tables as drift and
# tries to drop them.
DATABASE_URL=postgresql://dharma:dharma@localhost:5432/dharma?schema=auth

# ---- Qdrant ----
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ---- Backend ----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000

# ---- Frontend ----
# Browser-visible; must be a URL the browser can reach.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Server-side (inside Docker this becomes http://backend:8000).
API_INTERNAL_URL=http://localhost:8000

# ---- NextAuth ----
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-32-byte-random-string

# ---- Demo credentials (credentials provider, seeded on first run) ----
DEMO_ADMIN_EMAIL=admin@dharma.ai
DEMO_ADMIN_PASSWORD=admin123
DEMO_REVIEWER_EMAIL=reviewer@dharma.ai
DEMO_REVIEWER_PASSWORD=reviewer123
DEMO_USER_EMAIL=user@dharma.ai
DEMO_USER_PASSWORD=user123

# ---- Negotiation tuning ----
NEGOTIATION_MAX_ROUNDS=4
RISK_HIGH_THRESHOLD=70
RISK_MEDIUM_THRESHOLD=40

# ---- Error monitoring (optional) ----
# Unset: unhandled exceptions go to structured JSON logs (any aggregator can
# ingest them). Set: they go to Sentry, after secret scrubbing.
# Requires: pip install -r backend/requirements-observability.txt
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# ---- Secrets in production ----
# .env is right for local development. In production, prefer mounted secret
# files so values never appear in `docker inspect`, in child process
# environments, or in a crash dump. Dharma AI reads either.
#
#   Docker Swarm / Compose:
#     secrets:
#       openai_api_key:
#         file: ./secrets/openai_api_key
#     services:
#       backend:
#         secrets: [openai_api_key]
#         environment:
#           OPENAI_API_KEY_FILE: /run/secrets/openai_api_key
#
#   Kubernetes: mount the Secret at /run/secrets and the key is picked up by
#   name automatically (openai_api_key / OPENAI_API_KEY).
#
# Precedence: .env < environment variable < <NAME>_FILE < /run/secrets/<name>
# Supported for: OPENAI_API_KEY, QDRANT_API_KEY, DATABASE_URL
# OPENAI_API_KEY_FILE=/run/secrets/openai_api_key
