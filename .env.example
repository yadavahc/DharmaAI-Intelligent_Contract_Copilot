# ─────────────────────────────────────────────────────────────
# Dharma AI — environment configuration
# Copy to `.env` and fill in. NEVER commit the real `.env`.
# ─────────────────────────────────────────────────────────────

# ---- OpenAI ----
OPENAI_API_KEY=sk-replace-me
OPENAI_MODEL=gpt-4o
OPENAI_EMBED_MODEL=text-embedding-3-small

# ---- Demo mode ----
# When true, agents return deterministic canned output instead of calling
# OpenAI. Lets the full pipeline (and the Playwright e2e test) run with no
# API key, no spend, and no flakiness. Set to false for a live demo.
DHARMA_DEMO_MODE=false

# ---- Postgres ----
POSTGRES_USER=dharma
POSTGRES_PASSWORD=dharma
POSTGRES_DB=dharma
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Used by Prisma (frontend) and SQLAlchemy (backend).
DATABASE_URL=postgresql://dharma:dharma@localhost:5432/dharma?schema=public

# ---- Qdrant ----
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ---- Backend ----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000

# ---- Frontend ----
# Browser-visible; must be a URL the browser can reach.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Server-side (inside Docker this becomes http://backend:8000).
API_INTERNAL_URL=http://localhost:8000

# ---- NextAuth ----
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-32-byte-random-string

# ---- Demo credentials (credentials provider, seeded on first run) ----
DEMO_ADMIN_EMAIL=admin@dharma.ai
DEMO_ADMIN_PASSWORD=admin123
DEMO_REVIEWER_EMAIL=reviewer@dharma.ai
DEMO_REVIEWER_PASSWORD=reviewer123
DEMO_USER_EMAIL=user@dharma.ai
DEMO_USER_PASSWORD=user123

# ---- Negotiation tuning ----
NEGOTIATION_MAX_ROUNDS=4
RISK_HIGH_THRESHOLD=70
RISK_MEDIUM_THRESHOLD=40
